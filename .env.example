# GEMINI_API_KEY: Required for Gemini AI semantic search and subtitle translation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC secret for signing session cookies and payment tokens.
SESSION_SECRET="change-this-to-a-random-64-char-secret"

# ADMIN_MASTER_PASSWORD: Secondary administrator password for /admin elevation.
# Defaults to a securely hashed demo credential only in local dev if unset.
ADMIN_MASTER_PASSWORD=""

# TMDB_API_KEY: Optional TMDB API v3 key for fetching official film metadata and posters.
TMDB_API_KEY=""

# GOOGLE_CLIENT_ID: Optional Google OAuth Client ID for Google Sign-In.
GOOGLE_CLIENT_ID=""

# MIDTRANS_SERVER_KEY / XENDIT_SECRET_KEY: Optional Indonesian payment gateway keys.
MIDTRANS_SERVER_KEY=""
XENDIT_SECRET_KEY=""
